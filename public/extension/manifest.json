{
  "manifest_version": 3,
  "name": "Kyotei Analyzer Pro - テレボートPC自動投票拡張機能",
  "name:ja": "Kyotei Analyzer Pro - テレボートPC自動投票拡張機能",
  "version": "1.1.0",
  "description": "Kyotei Analyzer Pro 5とテレボート公式PC版（ib.mbrace.or.jp）を直結し、3連単の自動投入・ファイル投票・全自動購入・受付番号同期を実現する専用拡張機能です。",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://ib.mbrace.or.jp/*",
    "https://spweb.brtb.jp/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kyotei Analyzer Pro - テレボートPC自動投票",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ib.mbrace.or.jp/*",
        "https://spweb.brtb.jp/*"
      ],
      "js": [
        "teleboat_content.js"
      ],
      "css": [
        "teleboat_hud.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge_content.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge_content.js",
        "teleboat_hud.css",
        "icon16.png",
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
